.crumb { padding: 20rpx 24rpx 0; color: #8a9099; font-size: 24rpx; }
.sec-head { display: flex; align-items: center; padding: 8rpx 24rpx; }
.sec-title { flex: 1; font-size: 34rpx; font-weight: 500; }
.sec-ops { display: flex; }
.mini { font-size: 24rpx; padding: 8rpx 18rpx; margin-left: 12rpx; border-radius: 10rpx; background: #eef0f2; border: none; line-height: 1.6; }
.mini.on { background: #008C45; color: #fff; }
.mini.primary { background: #008C45; color: #fff; }

.counts { display: flex; gap: 24rpx; padding: 0 24rpx 12rpx; color: #8a9099; font-size: 24rpx; }

.block { margin: 16rpx 24rpx; background: #fff; border-radius: 16rpx; overflow: hidden; }
.block-hd { display: flex; align-items: center; padding: 20rpx 24rpx; border-bottom: 1rpx solid #f0f1f3; }
.bt { flex: 1; font-size: 28rpx; font-weight: 500; }

.row { display: flex; align-items: center; padding: 20rpx 24rpx; border-bottom: 1rpx solid #f5f6f8; }
.row.cur { background: #eaf3de; }
.body { flex: 1; min-width: 0; }
.es-line { display: flex; align-items: center; flex-wrap: wrap; }
.es { font-size: 30rpx; color: #008C45; font-weight: 500; }
.pos { color: #c0392b; font-size: 22rpx; margin-left: 10rpx; }
.ipa { color: #5f6b7a; font-size: 22rpx; margin-top: 4rpx; }
.zh-line { display: flex; align-items: center; flex-wrap: wrap; margin-top: 6rpx; }
.zh { font-size: 28rpx; color: #1f2329; }
.py { color: #8a9099; font-size: 22rpx; margin-left: 10rpx; }
.fem { color: #c0392b; font-size: 22rpx; margin-top: 6rpx; }

.spk { display: flex; flex-direction: column; gap: 10rpx; margin-left: 16rpx; }
.spk-btn { width: 64rpx; height: 56rpx; border-radius: 12rpx; background: #008C45; color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.spk-btn.zh { background: #c0392b; }

.range-bar { display: flex; align-items: center; gap: 12rpx; padding: 8rpx 24rpx 4rpx; }
.seg { padding: 8rpx 20rpx; border-radius: 10rpx; background: #eef0f2; font-size: 24rpx; color: #5f6b7a; }
.seg.on { background: #008C45; color: #fff; }
.range-bar .mini.primary { margin-left: auto; }
